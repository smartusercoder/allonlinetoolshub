/*
  # Security Headers
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  X-XSS-Protection: 1; mode=block
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(self), microphone=(self), geolocation=(), interest-cohort=(), payment=(), usb=()

  # Enhanced Content Security Policy
  Content-Security-Policy: default-src 'self'; font-src 'self' https://fonts.gstatic.com https://cdnjs.cloudflare.com data:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com; script-src 'self' 'unsafe-inline' 'unsafe-eval'; img-src 'self' data: blob: https:; connect-src 'self' https:; media-src 'self' blob: data: https:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; upgrade-insecure-requests

  # CORS and Cross-Origin Policies
  Cross-Origin-Embedder-Policy: credentialless
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: cross-origin

  # Cache Control for HTML (no cache for main page)
  Cache-Control: public, max-age=0, must-revalidate

# Static Assets - Long cache
/assets/*
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff

# Images - Medium cache
/*.png
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
  X-Content-Type-Options: nosniff

/*.jpg
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
  X-Content-Type-Options: nosniff

/*.svg
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
  X-Content-Type-Options: nosniff
  Content-Type: image/svg+xml

/*.ico
  Cache-Control: public, max-age=604800
  X-Content-Type-Options: nosniff

# Fonts - Long cache
/*.woff2
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff
  Access-Control-Allow-Origin: *

/*.woff
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff
  Access-Control-Allow-Origin: *

# Manifest and Service Worker - Short cache
/manifest.json
  Cache-Control: public, max-age=3600
  Content-Type: application/manifest+json
  X-Content-Type-Options: nosniff

/sw.js
  Cache-Control: public, max-age=0, must-revalidate
  Content-Type: application/javascript
  X-Content-Type-Options: nosniff

# Sitemaps - Daily cache
/sitemap*.xml
  Cache-Control: public, max-age=86400
  Content-Type: application/xml
  X-Content-Type-Options: nosniff

# Robots.txt - Weekly cache
/robots.txt
  Cache-Control: public, max-age=604800
  Content-Type: text/plain
